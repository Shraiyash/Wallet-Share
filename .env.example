# =============================================================================
# Hardhat / contract deployment secrets (ROOT of the repo).
# Copy this file to `.env` (which is git-ignored) and fill in the values.
# These are used ONLY for deploying the contract locally with Hardhat.
# They must NEVER be committed or pasted into Vercel.
# =============================================================================

# Your Sepolia RPC endpoint. Get a free one from:
#   - Alchemy:  https://dashboard.alchemy.com  (Create App -> Sepolia -> HTTPS URL)
#   - Infura:   https://app.infura.io
# Example: https://eth-sepolia.g.alchemy.com/v2/XXXXXXXXXXXXXXXXXXXX
SEPOLIA_RPC_URL=

# The PRIVATE KEY of the account that will deploy the contract (and become its
# owner). In MetaMask: pick the account holding your Sepolia test ETH ->
# Account details -> "Show private key". Paste it WITHOUT the 0x prefix or with
# it (both work). NEVER share this or commit it.
PRIVATE_KEY=

# Optional: Etherscan API key, only needed to verify the contract source on
# Sepolia Etherscan. Get one free at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
