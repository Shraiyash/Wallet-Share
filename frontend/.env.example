# =============================================================================
# Frontend (Vite) config. Copy to `frontend/.env` for local dev.
# For the Vercel deployment, set these SAME keys in the Vercel dashboard
# (Project -> Settings -> Environment Variables) BEFORE building — Vite bakes
# them into the bundle at build time.
#
# NOTE: everything here ships to the browser, so it must be PUBLIC-safe.
# Never put a private key here. (Contract-deploy secrets live in the ROOT .env.)
# =============================================================================

# ---- Local Ganache (default dev) --------------------------------------------
# VITE_CONTRACT_ADDRESS=0x85d17a400bEF4A86eab9A35baa8a814727EDb164
# VITE_CHAIN_ID=1337
# VITE_RPC_URL=http://127.0.0.1:7545

# ---- Public Sepolia testnet -------------------------------------------------
# Address printed by `npm run deploy:sepolia` (also saved to deployments/sepolia.json)
VITE_CONTRACT_ADDRESS=

# Sepolia chain id — do not change.
VITE_CHAIN_ID=11155111

# Your Sepolia RPC URL (same Alchemy/Infura URL used in the root .env is fine).
# Used for on-chain reads (balances, allowed users, etc.).
VITE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# WalletConnect project id (free): https://cloud.walletconnect.com
# Optional for MetaMask, but recommended for a public URL.
VITE_WALLETCONNECT_PROJECT_ID=
